<view class="container">
  <view class="card">
    <view class="card-title">1. 环境与配比参数调节</view>
    
    <view class="param-item">
      <text class="label">藻酸盐粉末类型</text>
      <picker bindchange="onPowderChange" value="{{powderIndex}}" range="{{powderOptions}}">
        <view class="picker-value">{{powderOptions[powderIndex]}}</view>
      </picker>
    </view>

    <!-- 水粉比 -->
    <view class="param-item">
      <view class="label-group">
        <text>水粉比系数 (Ratio)</text>
        <text class="val-text">{{ratio}}x</text>
      </view>
      <slider min="0.8" max="1.3" step="0.05" value="{{ratio}}" bindchange="onRatioChange" activeColor="#ff9500"/>
    </view>

    <!-- 环境温度 -->
    <view class="param-item">
      <view class="label-group">
        <text>环境温度 (Ambient Temp)</text>
        <text class="val-text">{{ambientTemp}} °C</text>
      </view>
      <slider min="10" max="40" value="{{ambientTemp}}" bindchange="onAmbientTempChange" activeColor="#00d4ff"/>
    </view>

    <!-- 水温 -->
    <view class="param-item">
      <view class="label-group">
        <text>水温 (Water Temp)</text>
        <text class="val-text">{{waterTemp}} °C</text>
      </view>
      <slider min="10" max="40" value="{{waterTemp}}" bindchange="onTempChange" activeColor="#007aff"/>
    </view>

    <!-- 环境湿度 -->
    <view class="param-item">
      <view class="label-group">
        <text>环境湿度 (Humidity)</text>
        <text class="val-text">{{humidity}} %RH</text>
      </view>
      <slider min="20" max="100" value="{{humidity}}" bindchange="onHumidityChange" activeColor="#34c759"/>
    </view>

    <!-- 动态展开/收起按钮 -->
    <button class="btn-sim" bindtap="toggleSimulation">
      流程模拟 {{showSim ? '▲ 收起' : '▼ 预览时长'}}
    </button>
  </view>

  <!-- 模拟计算结果列表 -->
  <view class="card" wx:if="{{showSim}}">
    <view class="card-title">2. 各阶段预测时长</view>
    <view class="sim-list">
      <view class="sim-item"><text>混料阶段</text><text class="highlight">{{phase.premix}} 秒</text></view>
      <view class="sim-item"><text>调拌阶段</text><text class="highlight">{{phase.mix}} 秒</text></view>
      <view class="sim-item"><text>消泡阶段</text><text class="highlight">{{phase.load}} 秒</text></view>
      <view class="sim-item"><text>固化阶段</text><text class="highlight">{{phase.set}} 秒</text></view>
      <view class="sim-item"><text>建议灌模窗口</text><text class="highlight">{{phase.pourWindowMin}} 分钟内</text></view>
    </view>
  </view>

  <button class="btn-start-large" bindtap="startProcess">开始操作</button>

  <view class="timer-overlay" wx:if="{{running}}">
    <view class="stage-name">{{currentStage.name}}</view>
    <view class="big-countdown">{{timeLeft}}</view>
    <view class="voice-tip">{{currentStage.prompt}}</view>
    <button class="btn-cancel" bindtap="stopProcess">停止 / 重置</button>
  </view>
</view>
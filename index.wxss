.container { 
  padding: 16px; 
  background: #0f172a; 
  min-height: 100vh; 
  color: #f8fafc; 
  box-sizing: border-box;
}

.card { 
  background: #1e293b; 
  border-radius: 12px; 
  padding: 16px; 
  margin-bottom: 16px; 
  border: 1px solid #334155; 
}

.card-title { 
  font-size: 16px; 
  font-weight: bold; 
  color: #38bdf8; 
  margin-bottom: 16px; 
}

.param-item { 
  margin-bottom: 16px; 
}

.label-group { 
  display: flex; 
  justify-content: space-between; 
  font-size: 14px; 
  margin-bottom: 6px; 
}

.val-text { 
  color: #38bdf8; 
  font-weight: bold; 
}

.picker-value { 
  background: #334155; 
  padding: 8px 12px; 
  border-radius: 6px; 
  font-size: 14px; 
  color: #fff; 
  margin-top: 6px; 
}

.btn-sim { 
  background: #334155; 
  color: #38bdf8; 
  font-size: 14px; 
  border-radius: 8px; 
  margin-top: 10px; 
}

.sim-list { 
  display: flex; 
  flex-direction: column; 
  gap: 8px; 
  font-size: 14px; 
}

.sim-item { 
  display: flex; 
  justify-content: space-between; 
  padding: 6px 0; 
  border-bottom: 1px solid #334155; 
}

.highlight { 
  color: #4ade80; 
  font-weight: bold; 
}

.btn-start-large { 
  background: #2563eb; 
  color: #fff; 
  font-size: 22px; 
  font-weight: bold; 
  padding: 16px 0; 
  border-radius: 12px; 
  margin-top: 20px; 
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4); 
}

/* 倒计时全屏遮罩层 */
.timer-overlay { 
  position: fixed; 
  top: 0; 
  left: 0; 
  right: 0; 
  bottom: 0; 
  background: #090d16; 
  display: flex; 
  flex-direction: column; 
  justify-content: space-between; 
  align-items: center; 
  z-index: 999; 
  padding: 60rpx 40rpx; 
  box-sizing: border-box;
}

.stage-name { 
  color: #38bdf8; 
  font-size: 32px; 
  font-weight: bold; 
  margin-top: 20rpx;
  text-align: center;
}

/* 极大号倒计时数字 */
.big-countdown { 
  color: #f43f5e; 
  font-size: 240px; 
  font-weight: 900; 
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
  line-height: 1; 
  margin: 10px 0; 
  text-shadow: 0 0 25px rgba(244, 63, 94, 0.35);
  text-align: center;
  width: 100%;
}

.voice-tip { 
  color: #facc15; 
  font-size: 20px; 
  text-align: center; 
  line-height: 1.5; 
  padding: 0 20rpx;
}

.btn-cancel { 
  margin-bottom: 20rpx; 
  background: #dc2626; 
  color: #fff; 
  width: 180px; 
  border-radius: 25px; 
  font-size: 16px;
}